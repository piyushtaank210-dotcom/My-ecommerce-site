# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build Output
/.next/
/out/
/build/
/dist/

# TypeScript Build & Environment Info
next-env.d.ts
tsconfig.tsbuildinfo

# Environment & Secrets
.env
.env*.local
# The live gateway keys, kept apart so that the shop can be switched
# between the test keys and the live ones. The pattern above does not
# catch this one — `.env.local.live` does not end in `.local`.
.env.local.live
*.pem

# SQLite Database & Storage
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.db.*
!data/store.db
*.sqlite
*.sqlite3
local.db

# User Uploads (keep directory structure tracked via .gitkeep)
#
# The catalogue points at these photographs, so they have to travel with the
# repository — otherwise four of the nine products show a broken picture on the
# live site. The "!public/uploads/**/" line matters: "public/uploads/*"
# matches the folders themselves, and git will not look inside a folder it
# has been told to ignore.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/**/
!public/uploads/**/*.jpg
!public/uploads/**/*.jpeg
!public/uploads/**/*.png
!public/uploads/**/*.webp
!public/uploads/**/*.avif
public/products/*.svg

# The private evidence store.
#
# A customer's photographs and videos are evidence of their claim. They
# are kept outside the public folder and are fetched through a route
# that checks who is asking, so they are never served to anybody who
# has not signed in and been let in. Nothing in here is ever committed.
private/

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Browser Testing Profiles & Scratch Assets
/.shots/
/.chrome-profile/
/.chrome-profile-*/
/.chrome-probe/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
