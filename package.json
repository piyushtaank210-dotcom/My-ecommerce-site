{
  "name": "consoleseller",
  "version": "1.0.0",
  "description": "ConsoleSeller — Consoles & Gaming Accessories e-commerce store with return, replacement & refund management system",
  "private": true,
  "author": "ConsoleSeller <consoleseller.in@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "node scripts/seed.mjs",
    "db:migrate": "node scripts/migrate-to-postgres.mjs",
    "db:checkpoint": "node scripts/checkpoint-db.mjs",
    "sync-hero": "node scripts/sync-hero.mjs",
    "sync-hero:live": "node scripts/sync-hero-live.mjs",
    "encode:hero": "node scripts/encode-hero-video.mjs",
    "encode:hero:mobile": "node scripts/encode-hero-mobile.mjs",
    "icons": "node scripts/icons.mjs",
    "hero:posters": "node scripts/hero-frame.mjs public/hero/hero-console-web.mp4 public/hero/hero-console-web-poster.jpg 0 1280 614 && node scripts/hero-frame.mjs public/hero/hero-controller-web.mp4 public/hero/hero-controller-web-poster.jpg 0 1280 614",
    "hero:posters:mobile": "node scripts/hero-frame.mjs public/hero/hero-mobile-showcase.mp4 public/hero/hero-mobile-showcase-poster.jpg 0 1080 1434",
    "hero:build": "npm run encode:hero && npm run encode:hero:mobile && npm run hero:posters && npm run hero:posters:mobile",
    "sync-categories": "node scripts/sync-categories.mjs",
    "sync-variants": "node scripts/sync-variants.mjs",
    "schema": "node scripts/write-schema.mjs",
    "staff": "node scripts/create-staff.mjs",
    "set-role": "node scripts/set-role.mjs",
    "images": "node scripts/fetch-images.mjs",
    "setup": "npm run images && npm run seed",
    "e2e": "node scripts/e2e.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:database": "node scripts/check-database.mjs",
    "check:async": "node scripts/check-async.mjs",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:inventory": "node scripts/check-inventory.mjs",
    "check:variations": "node scripts/check-variations.mjs",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "check:import": "node scripts/check-import.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:product": "node scripts/check-product-form.mjs",
    "check:mobile": "node scripts/audit-mobile.mjs && node scripts/check-labels.mjs",
    "check:admin-nav": "node scripts/check-admin-flow.mjs && node scripts/check-admin-walk.mjs && node scripts/check-admin-redirect.mjs && node scripts/check-signout.mjs",
    "check:admin-returns": "node scripts/check-admin-returns.mjs",
    "check:return-policy": "node scripts/check-return-policy.mjs",
    "check:returns": "node scripts/check-returns.mjs && node scripts/check-return-policy.mjs",
    "check:hero": "node scripts/check-hero-video.mjs && node scripts/check-hero-pause.mjs && node scripts/check-hero-swipe.mjs",
    "clean:e2e": "node scripts/clean-e2e-accounts.mjs",
    "shot": "node scripts/screenshot.mjs",
    "shot:at": "node scripts/shot-at.mjs",
    "check:return-actions": "node scripts/check-admin-return-actions.mjs",
    "check:return-replacement": "node scripts/check-admin-return-replacement.mjs",
    "check:returns:api": "node scripts/check-returns-api.mjs",
    "check:returns:pages": "node scripts/check-returns-pages.mjs",
    "check:returns:customer": "node scripts/check-returns-customer.mjs",
    "check:returns:all": "npm run check:returns && npm run check:refunds && npm run check:return-policy && npm run check:return-settings && npm run check:return-notifications && npm run check:enquiries && npm run check:resend && npm run check:resend:delivery && npm run check:returns:api && npm run check:returns:pages && npm run check:returns:customer",
    "db:schema": "node scripts/apply-schema.mjs",
    "check:refunds": "node scripts/check-refunds.mjs",
    "check:razorpay": "node scripts/check-razorpay.mjs",
    "check:razorpay:webhook": "node scripts/check-razorpay-webhook.mjs",
    "gateway:mode": "node scripts/gateway-mode.mjs",
    "deploy:env": "node scripts/deploy-env.mjs",
    "mock:gateway": "node scripts/lib/mock-gateway.mjs",
    "cleanup:razorpay": "node scripts/cleanup-razorpay-orders.mjs",
    "check:return-settings": "node scripts/check-return-settings.mjs",
    "check:enquiries": "node scripts/check-enquiries.mjs",
    "check:return-notifications": "node scripts/check-return-notifications.mjs",
    "check:resend": "node scripts/check-resend.mjs",
    "check:resend:delivery": "node scripts/check-resend-delivery.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "pg": "^8.16.3",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
