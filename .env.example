# ==========================================
# ConsoleSeller (.env.example)
# Copy this file to .env.local for local overrides
# ==========================================

# Base application URL (default: http://localhost:3000)
BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://consoleseller.in"

# Local Server Port (optional)
PORT=3000

# Initial Admin & Support Credentials for seed scripts
PF_ADMIN_EMAIL="consoleseller.in@gmail.com"
PF_ADMIN_PASSWORD="your-secure-admin-password"

PF_SUPPORT_EMAIL="support@consoleseller.in"
PF_SUPPORT_PASSWORD="your-secure-support-password"

# ==========================================
# The shop's database
# ==========================================
# PostgreSQL. The shop used to keep a SQLite file in the repository, which
# only works while there is one machine — on a serverless host every
# instance gets its own copy of the file, and an order placed on one
# instance is invisible to the next. PostgreSQL is one database that every
# instance shares.
#
# This one is required. The connection string is a secret, so it lives here
# in .env.local — which Git ignores — and never in the source. Without it
# the shop says so plainly rather than starting up against a database
# nobody chose.
#
# DATABASE_URL="postgresql://user:password@host:5432/consoleseller"

# How many connections the shop may hold open. Each request that is
# holding a transaction holds one for as long as it runs.
# DATABASE_POOL_MAX=10

# Whether the connection to PostgreSQL is encrypted. "require" turns it on,
# "disable" turns it off, and without either it is on in production and off
# in development — which is right for a hosted PostgreSQL and for one
# running on the same machine.
# DATABASE_SSL="require"

# ==========================================
# Email — Resend
# ==========================================
#
# The shop sends through Resend. The API key is read from the
# environment and is never written down anywhere else.
#
# To get emails going, set BOTH of these:
#
#   RESEND_API_KEY  — your Resend API key (resend.com → API Keys)
#   MAIL_FROM       — the sender, written out in full, on a domain you
#                     own and have verified in Resend. Your domain
#                     consoleseller.in is set up there.
#
# A Gmail address cannot be used as the sender: Resend will not send
# from one. Use orders@consoleseller.in, or a sender on that domain
# that you have verified.
#
# With these set, the shop sends the customer an email for every step
# of a return, a replacement and a refund, and for the order
# confirmations, the order status updates, the dispatch and delivery
# notices, and the cancellations.
#
# Without them, every message is still recorded and still shown on the
# customer's dashboard — it is simply marked as not sent, and it can
# be sent once the keys are in place.

# Your Resend API key.
# RESEND_API_KEY="re_..."

# The address the shop sends from.
# MAIL_FROM="Consoleseller Orders <orders@consoleseller.in>"

# Where the shop's own enquiries are sent — the notification about a
# new enquiry from the contact page. It is the recipient, so a Gmail
# address is right here.
# ENQUIRY_NOTIFICATION_EMAIL="consoleseller.in@gmail.com"
# ==========================================
# Deployment
# ==========================================

# The key the sign-in cookie is signed with. It must be the same on every
# instance, and it must be different for every shop. Without it the app
# falls back to a key published in the source, which keeps a single-machine
# install working but is not a secret.
# SESSION_SECRET="a-long-random-string"
